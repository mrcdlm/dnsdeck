# Cloudflare API-Token (Rechte: Zone/DNS/Edit, Zone/Zone/Read, Account/Cloudflare Tunnel/Read)
CF_API_TOKEN=dein-cloudflare-api-token

# Cloudflare Account-ID (Dashboard → Domain → rechte Seitenleiste)
CF_ACCOUNT_ID=deine-account-id

# Passwort für das Web-Dashboard
APP_PASSWORD=ein-sicheres-passwort

# Optional
# PORT=8080
# LOG_LEVEL=info
