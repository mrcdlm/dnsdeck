# Vorlage: nach deploy/.env kopieren und Werte eintragen.

# Feste Version, nie latest (Updates bewusst nach Release Notes).
# Verfügbare Versionen: https://github.com/mrcdlm/dnsdeck/releases (ohne "v")
DNSDECK_VERSION=0.1.0

# Cloudflare API-Token (Rechte: Zone/DNS/Edit, Zone/Zone/Read, Account/Cloudflare Tunnel/Read)
CF_API_TOKEN=dein-cloudflare-api-token

# Cloudflare Account-ID (Dashboard → Domain → rechte Seitenleiste)
CF_ACCOUNT_ID=deine-account-id

# Passwort für das Web-Dashboard (Klartext oder bcrypt-Hash, max. 72 Bytes)
APP_PASSWORD=ein-sicheres-passwort

# Optional
# PORT=8080
# LOG_LEVEL=info
# DATA_DIR=/data

# Webhooks (optional): Geheimnisse für Webhooks, die du unter Einstellungen
# anlegst. Dort als ${WEBHOOK_NAME} (URL/Header) bzw. {{env "WEBHOOK_NAME"}}
# (Body) verwenden. Nur Variablen mit Präfix WEBHOOK_ sind erlaubt.
# WEBHOOK_NTFY_TOPIC=dein-geheimes-topic
# WEBHOOK_GOTIFY_TOKEN=dein-gotify-app-token
# WEBHOOK_TELEGRAM_TOKEN=123456:abc
# WEBHOOK_TELEGRAM_CHAT_ID=123456789
# WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/…
