# dnsdeck configuration – copy to .env and fill in the values.
# Never commit .env: it contains secrets.

# --- Deployment (read by Docker Compose) -----------------------------------

# Image version to run (without "v"). Pinned on purpose – no "latest".
# Available versions: https://github.com/mrcdlm/dnsdeck/releases
DNSDECK_VERSION=0.1.0

# Host port for the web interface (default 8080)
# DNSDECK_PORT=8080

# Time zone for log timestamps (default UTC)
# TZ=Europe/Berlin

# --- Required --------------------------------------------------------------

# Password for the web interface (plain text or bcrypt hash, max. 72 bytes)
APP_PASSWORD=change-me-to-a-long-random-password

# --- Cloudflare ------------------------------------------------------------

# API token with: Zone → DNS → Edit, Zone → Zone → Read,
# Account → Cloudflare Tunnel → Read (only needed for tunnel monitoring)
CF_API_TOKEN=your-cloudflare-api-token

# Account ID (Cloudflare dashboard → any domain → right sidebar);
# only needed for tunnel monitoring
CF_ACCOUNT_ID=your-cloudflare-account-id

# --- Webhook secrets (optional) --------------------------------------------
# Webhooks are configured in the web interface (Settings). Reference secrets
# there as ${WEBHOOK_NAME} (URL, headers) or {{env "WEBHOOK_NAME"}} (body).
# Only variables with the prefix WEBHOOK_ can be referenced.
# WEBHOOK_NTFY_TOPIC=your-secret-topic
# WEBHOOK_GOTIFY_TOKEN=your-gotify-app-token
# WEBHOOK_TELEGRAM_TOKEN=123456:ABC-your-bot-token
# WEBHOOK_TELEGRAM_CHAT_ID=123456789
# WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/...

# --- Advanced (optional) ---------------------------------------------------
# LOG_LEVEL=info          # debug | info | warn | error
# PORT=8080               # port inside the container
# DATA_DIR=/data          # database directory inside the container
